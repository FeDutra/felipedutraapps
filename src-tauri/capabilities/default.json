{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main"
  ],
  "remote": {
    "urls": ["http://127.0.0.1:14322/*"]
  },
  "permissions": [
    "allow-local-open-url",
    "allow-execute-applescript",
    "allow-local-music-play",
    "allow-execute-shell-command",
    "allow-execute-long-command-stream",
    "allow-desktop-boot-probe",
    "allow-local-presence-read",
    "allow-local-device-origin-status",
    "allow-local-device-origin-assert",
    "allow-voice-recording-begin",
    "allow-voice-recording-append",
    "allow-voice-recording-finalize",
    "allow-voice-recording-mark",
    "allow-voice-recording-recover-incomplete",
    "allow-ensure-kokoro-sidecar",
    "allow-bridge-request",
    "allow-store-provider-secret",
    "allow-hydrate-provider-secret",
    "allow-provider-secret-status",
    "allow-delete-provider-secret",
    "allow-core-canary-rendered",
    "allow-shutdown-bridge",
    "core:default",
    "http:default",
    {
      "identifier": "http:default",
      "allow": [{ "url": "https://**" }, { "url": "http://**" }]
    }
  ]
}
