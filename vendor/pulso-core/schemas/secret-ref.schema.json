{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pulso.secret_ref_descriptor.v1",
  "type": "object",
  "required": [
    "secretRef",
    "scheme",
    "keyId",
    "configured",
    "redactedPreview",
    "checkedAt"
  ],
  "properties": {
    "secretRef": { "type": ["string", "null"] },
    "scheme": { "enum": ["env", "memory", "keychain", "none"] },
    "keyId": { "type": ["string", "null"] },
    "configured": { "type": "boolean" },
    "redactedPreview": { "type": "string", "minLength": 1 },
    "checkedAt": { "type": ["string", "null"], "format": "date-time" }
  },
  "additionalProperties": false
}
