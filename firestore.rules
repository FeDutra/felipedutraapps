rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isPulsoOwner() {
      return request.auth != null
        && request.auth.token.email == "felipemachadodutra@gmail.com";
    }

    // Projeções do operador: o browser nunca cria nem remove autoridade.
    // O Admin SDK do bridge não passa por estas regras.
    match /workspaces/felipe_dutra/pulso_operator_approvals/{approvalId} {
      allow read: if isPulsoOwner();
      allow create, delete: if false;
      allow update: if isPulsoOwner()
        && resource.data.status == "pending"
        && request.resource.data.status == "resolving"
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(["status", "decisionRequest", "updatedAt"])
        && request.resource.data.decisionRequest.requestedBy == "pulso"
        && resource.data.allowedDecisions.hasAny([
          request.resource.data.decisionRequest.decision
        ]);
    }

    match /workspaces/felipe_dutra/pulso_operator_runtime/{documentId} {
      allow read: if isPulsoOwner();
      allow write: if false;
    }

    // Workspace pessoal: acesso somente para usuário autenticado com Google
    match /workspaces/{workspaceId}/{collectionId}/{document=**} {
      allow read, write: if request.auth != null
        && workspaceId == "felipe_dutra"
        && collectionId != "pulso_operator_approvals"
        && collectionId != "pulso_operator_runtime";
    }

    // Qualquer outro path: bloqueado por padrão
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
